{
  "name": "animuse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:assets && next dev --hostname 127.0.0.1",
    "registry": "node --experimental-strip-types scripts/build-registry.mts",
    "prebuild": "npm run prepare:assets",
    "docs:assets": "node --experimental-strip-types scripts/build-doc-assets.mts",
    "assets:optimize": "node scripts/optimize-media.mjs",
    "test:performance": "node --test scripts/performance-budget.test.mjs",
    "motion:build": "node --experimental-strip-types scripts/build-motion-components.mts && npm run motion:site",
    "motion:site": "node scripts/build-site-motion.mjs",
    "test:delivery": "node --test scripts/resource-cache.test.mjs scripts/motion-document.test.mjs scripts/site-motion.test.mjs",
    "test:delivery:browser": "node scripts/test-resource-loading.mjs",
    "test:delivery:site": "node scripts/test-site-motion.mjs",
    "test:delivery:bandwidth": "node scripts/test-delivery-bandwidth.mjs",
    "test:delivery:github": "node scripts/test-github-refresh.mjs",
    "test:motion": "npm run motion:build && node scripts/test-motion-components.mjs",
    "test:motion:docs": "node scripts/test-motion-docs.mjs",
    "test:motion:types": "node scripts/test-motion-types.mjs",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint",
    "preview": "npm run start",
    "ai:catalog": "node --experimental-strip-types scripts/build-ai-catalog.mts",
    "ui": "node scripts/collection-cli.mjs",
    "test:ai": "node --test scripts/collection-cli.test.mjs scripts/animuse-skill.test.mjs",
    "test:actions": "node scripts/test-ui-actions.mjs",
    "test:locale": "node scripts/test-localization.cjs",
    "test:filters": "node --test scripts/atlas-filters.test.mjs",
    "test:filters:browser": "node scripts/test-atlas-filters-browser.mjs",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "prepare:assets": "npm run brand:build && npm run motion:build && npm run registry && npm run docs:assets && npm run assets:optimize && npm run ai:catalog",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@types/three": "^0.185.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuelume": "^0.1.2",
    "geist": "^1.7.2",
    "gsap": "3.12.7",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "vgpu": "^0.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@radix-ui/react-slider": "^1.4.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@webgpu/types": "^0.1.72",
    "babel-preset-solid": "^1.9.16",
    "deep-agent-base-ui": "npm:@base-ui/react@^1.8.0",
    "deep-agent-lucide": "npm:lucide-react@^1.43.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.64.1",
    "preact": "^10.25.4",
    "react-circular-progressbar": "^2.2.0",
    "sharp": "0.34.5",
    "solid-js": "^1.9.14",
    "svelte": "^5.57.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vue": "^3.5.44",
    "wrangler": "^4.111.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaoli2003/Animuse.git"
  },
  "homepage": "https://github.com/zhaoli2003/Animuse#readme",
  "bugs": {
    "url": "https://github.com/zhaoli2003/Animuse/issues"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "engines": {
    "node": ">=22.18.0"
  }
}
